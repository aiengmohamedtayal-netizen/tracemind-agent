# VITE_API_BASE_URL: Base URL for the TraceMind Python/FastAPI backend.
# Local development uses the Vite /api proxy (target defaults to http://127.0.0.1:8000).
VITE_API_BASE_URL="/api"

# VITE_BACKEND_PROXY_TARGET: Target URL for the Vite dev server /api proxy.
VITE_BACKEND_PROXY_TARGET="http://127.0.0.1:8000"
